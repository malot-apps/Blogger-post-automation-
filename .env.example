# Gemini API Key (Server-side secret)
GEMINI_API_KEY=

# Dedicated Blogger Image Host Configuration
# The Blog ID of the dedicated secondary Blogger site used as the image host
BLOGGER_IMAGE_HOST_BLOG_ID=

# Optional base URL of the image host site
BLOGGER_IMAGE_HOST_BASE_URL=

# Server-side Google OAuth client ID for independent Blogger authentication
BLOGGER_CLIENT_ID=

# Server-side Google OAuth client secret for independent Blogger authentication
BLOGGER_CLIENT_SECRET=

# Server-side Google OAuth refresh token for automated background image hosting
BLOGGER_REFRESH_TOKEN=
