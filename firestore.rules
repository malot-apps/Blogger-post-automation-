rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation: User Profile
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
        (!('defaultBlogId' in data) || (data.defaultBlogId is string && data.defaultBlogId.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        data.keys().hasAll(['userId']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'defaultBlogId', 'updatedAt']);
    }

    // Entity Validation: Published Post
    function isValidPublishedPost(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.blogId is string &&
        data.blogId.size() > 0 &&
        data.blogId.size() <= 128 &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 300 &&
        data.url is string &&
        data.url.size() > 0 &&
        data.url.size() <= 1000 &&
        (!('caption' in data) || (data.caption is string && data.caption.size() <= 5000)) &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048)) &&
        (!('labels' in data) || (data.labels is string && data.labels.size() <= 500) || (data.labels is list && data.labels.size() <= 50)) &&
        (!('publishedAt' in data) || (data.publishedAt is string && data.publishedAt.size() <= 64)) &&
        data.keys().hasAll(['id', 'userId', 'blogId', 'title', 'url']) &&
        data.keys().hasOnly(['id', 'userId', 'blogId', 'title', 'caption', 'url', 'thumbnailUrl', 'labels', 'publishedAt']);
    }

    // Connection validation test path
    match /test/connection {
      allow get: if isSignedIn();
    }

    // User profile and settings
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII Protection: queries across all users are forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User post publishing history
      match /posts/{postId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(postId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(postId) &&
          incoming().id == postId &&
          isValidPublishedPost(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(postId) &&
          isValidPublishedPost(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(postId);
      }
    }
  }
}
