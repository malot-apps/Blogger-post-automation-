{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and publishing settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        },
        "defaultBlogId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId", "email"]
    },
    "publishedPost": {
      "title": "PublishedPost",
      "description": "Record of a post published to Blogger",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "blogId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "caption": {
          "type": "string",
          "maxLength": 5000
        },
        "url": {
          "type": "string",
          "maxLength": 1000
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "labels": {
          "type": "string",
          "maxLength": 500
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "blogId", "title", "url"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "User profile and settings"
    },
    "/users/{userId}/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/publishedPost"
      },
      "description": "History of posts published to Blogger by user"
    }
  }
}
