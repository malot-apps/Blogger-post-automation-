{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and publishing settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        },
        "defaultBlogId": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["userId"]
    },
    "publishedPost": {
      "title": "PublishedPost",
      "description": "Record of a post published to Blogger",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "blogId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "caption": {
          "type": "string",
          "maxLength": 5000
        },
        "url": {
          "type": "string",
          "maxLength": 1000
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "labels": {
          "type": "string",
          "maxLength": 500
        },
        "publishedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "blogId", "title", "url"]
    },
    "adsSettings": {
      "title": "AdsSettings",
      "description": "Per-user advertisement links and banner settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "smartLink": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string", "maxLength": 1000 }
          },
          "required": ["enabled", "url"]
        },
        "directLink": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string", "maxLength": 1000 }
          },
          "required": ["enabled", "url"]
        },
        "popupAd": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string", "maxLength": 1000 }
          },
          "required": ["enabled", "url"]
        },
        "bannerAd": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "imageUrl": { "type": "string", "maxLength": 2048 },
            "clickUrl": { "type": "string", "maxLength": 1000 }
          },
          "required": ["enabled", "imageUrl", "clickUrl"]
        },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "smartLink", "directLink", "popupAd", "bannerAd"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "User profile and settings"
    },
    "/users/{userId}/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/publishedPost"
      },
      "description": "History of posts published to Blogger by user"
    },
    "/users/{userId}/adsSettings/{settingId}": {
      "schema": {
        "$ref": "#/entities/adsSettings"
      },
      "description": "User advertisement configuration"
    }
  }
}
